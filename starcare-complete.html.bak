<script>
(function() {
  // Page navigation
  const pages = document.querySelectorAll('.page, .cover, .toc');
  let currentPage = 0;

  // Page indicator
  const indicator = document.createElement('div');
  indicator.className = 'page-indicator';
  document.body.appendChild(indicator);
  indicator.textContent = '1 / ' + pages.length;

  // Nav controls
  const nav = document.createElement('div');
  nav.className = 'nav-controls';
  document.body.appendChild(nav);

  const prevBtn = document.createElement('button');
  prevBtn.textContent = '← Prev';
  prevBtn.onclick = function() {
    if (currentPage > 0) { currentPage--; scrollToPage(currentPage); }
  };
  const nextBtn = document.createElement('button');
  nextBtn.textContent = 'Next →';
  nextBtn.onclick = function() {
    if (currentPage < pages.length - 1) { currentPage++; scrollToPage(currentPage); }
  };
  nav.appendChild(prevBtn);
  nav.appendChild(nextBtn);

  function scrollToPage(idx) {
    pages[idx].scrollIntoView({ behavior: 'smooth' });
    indicator.textContent = (idx + 1) + ' / ' + pages.length;
    currentPage = idx;
  }

  // Intersection Observer for scroll tracking
  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        const idx = Array.prototype.indexOf.call(pages, entry.target);
        if (idx !== -1) {
          currentPage = idx;
          indicator.textContent = (idx + 1) + ' / ' + pages.length;
          prevBtn.disabled = idx === 0;
          nextBtn.disabled = idx === pages.length - 1;
        }
      }
    });
  }, { rootMargin: '-40% 0px -40% 0px' });

  pages.forEach(function(page) { observer.observe(page); });

  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown' || e.key === 'PageDown') {
      e.preventDefault();
      if (currentPage < pages.length - 1) { currentPage++; scrollToPage(currentPage); }
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault();
      if (currentPage > 0) { currentPage--; scrollToPage(currentPage); }
    } else if (e.key === 'Home') {
      e.preventDefault();
      currentPage = 0; scrollToPage(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      currentPage = pages.length - 1; scrollToPage(currentPage);
    }
  });
})();
</script>

