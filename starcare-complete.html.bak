<style>
/* ===== DESIGN SYSTEM ===== */
:root {
  --primary: #2D5F3E;
  --primary-dark: #1E4A2E;
  --accent: #D4913C;
  --bg: #FFFFFF;
  --text: #1A1A1A;
  --text-muted: #6B6B6B;
  --border: #E0DCD7;
  --surface: #F9F7F5;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
}

/* ===== PAGE CONTAINER ===== */
.page {
  max-width: 800px;
  margin: 0 auto;
  background: var(--bg);
  padding: 3.5rem 4rem;
  position: relative;
}
.page::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
